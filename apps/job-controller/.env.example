# ClickHouse (same DB the parser writes to — see clickhouse-schema/schema.sql)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=health

# Redis (job queue backing store)
REDIS_URL=redis://localhost:6379

# Queue poll interval in ms
POLL_INTERVAL_MS=5000

# Job ownership / recovery. NODE_ID defaults to hostname-pid.
# Every node heartbeats node:{NODE_ID}; a job whose owner has no heartbeat for
# HEARTBEAT_TTL_MS is put back at the head of its queue (up to MAX_JOB_ATTEMPTS,
# then parked in {queue}:dead).
#NODE_ID=
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TTL_MS=30000
REAPER_INTERVAL_MS=30000
MAX_JOB_ATTEMPTS=3

# Node roles. Independent — enable either or both on the same node.
#   MANAGEMENT_NODE=true  -> polls the task queues (index-scan, discovery, cleanup)
#   FILE_NODE=true        -> polls the tiered file queues (download -> decompress -> parse)
#   FILE_NODE defaults to !MANAGEMENT_NODE, so old single-role .env files keep working.
#   RAM_NODE picks RAM-disk vs regular-disk staging for the file role.
MANAGEMENT_NODE=false
FILE_NODE=true
RAM_NODE=false

# Management role limits
MAX_CONCURRENT_TASKS=4
MAX_TASK_ATTEMPTS=3

# File role: how many jobs run at once (each = one download + one parser process).
# The storage budget is NOT a concurrency limit; without this a large node starts
# thousands of downloads at once and finishes none.
MAX_CONCURRENT_FILES=4

# Storage available for staging files on this node. Accepts bytes or 512MB / 8GB.
# RAM nodes use RAM_DISK_TOTAL, disk nodes use DISK_TOTAL.
RAM_DISK_TOTAL=8GB
DISK_TOTAL=500GB

# Largest single file this node will accept, measured as the DECOMPRESSED footprint
# (sizeBytes x COMPRESSED_EXPANSION_RATIO). A 10 GB .gz needs ~150 GB here.
MAX_FILE_BYTES=25GB

# ── File staging (file nodes) ──────────────────────────────────────────────
# Where files are downloaded and decompressed. One subdirectory per job, removed when it ends.
# RAM nodes default to /dev/shm/mrf, disk nodes to /tmp/mrf.
#STAGING_DIR=/tmp/mrf
# Assumed decompressed:compressed ratio for .gz/.zip/.zst files. The budget reserves
# sizeBytes * this before a job starts, then corrects to the real size once staged.
COMPRESSED_EXPANSION_RATIO=15
# Keep staged files after a job finishes (debugging).
KEEP_STAGED_FILES=false

# Parser binary the file node invokes: <bin> <file.json> in_network_rates <job id>
PARSER_BIN=../../parser-tools/parser-rs/target/release/main
# Env vars forwarded to the parser process (comma-separated).
#PARSER_ENV_PASSTHROUGH=SINK,CLICKHOUSE_URL,CLICKHOUSE_USER,CLICKHOUSE_PASSWORD,CLICKHOUSE_DATABASE,THREADS,ZOMBIE_FILTER

# ── Dashboard ──────────────────────────────────────────────────────────────
# Read-only web UI: live node activity, per-job step progress, queue depths.
WEB_ENABLED=true
# Unset -> a random free port is used AND the page opens in a browser (laptop case).
# Set    -> that exact port, and no browser is opened (server/container case).
#WEB_PORT=3000
# Override the open-a-browser default either way.
#WEB_OPEN=false

# Console output kept per operation for the dashboard expander. Written to the project's tmp dir
# and CLEARED on every boot, so "history" means "since this node started".
#LOG_DIR=./tmp/job-logs
LOG_KEEP_LINES=500      # lines kept in memory per operation (the file keeps everything)
LOG_KEEP_RUNS=200       # finished operations kept in the list

# Shutdown. The first Ctrl-C / SIGTERM stops taking new work and finishes what is running
# (a download or parser run can take minutes); a second Ctrl-C force quits immediately.
# Force quit anyway after this long. 0 = wait forever.
SHUTDOWN_TIMEOUT_MS=30000

# Report every file job / management task to ClickHouse `job_runs` (status + console output).
JOB_RECORDS_ENABLED=true
JOB_LOG_MAX_BYTES=262144        # console output kept per record, tail-truncated. 0 = no logs
JOB_RECORDS_FLUSH_MS=2000       # batching window for step updates
