// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model InsuranceCompany {
  id               String                @id @db.VarChar(50)
  displayName      String                @db.VarChar(200)
  legalName        String                @db.VarChar(200)
  subsidiariesName String[]              @db.VarChar(200)
  createdAt        DateTime              @default(now())
  createdBy        String                @db.VarChar(50)
  updatedAt        DateTime              @updatedAt
  updatedBy        String                @db.VarChar(50)
  archivedBy       String?               @db.VarChar(50)
  archivedAt       DateTime?
  scanSources      InsuranceScanSource[]
  insurancePlans   InsurancePlan[]
}

enum InsuranceScanSourceType {
  INDEX_URL
  MANUAL
  // https://www.cigna.com/static/mrf/latest.json
  CIGNA_INDEX_API
  //  https://healthy.kaiserpermanente.org/pricing/innetwork/2025-11_List.txt https://healthy.kaiserpermanente.org/pricing/outofnetwork/sc/2025-11-01_KFHP_SCCOM-40513ca0380003-1_allowed-amounts.zip
  KAISER_PERMANENTE_TXT_IN_NETWORK
  KAISER_PERMANENTE_TXT_OUT_OF_NETWORK
  UNITED_HEATHCARE_BLOB_API
  AETNA_BLOB_API
  HCSC_SCRAPER
  // https://www.molinahealthcare.com/marketplace/ky/en-us/About/compinfo/PricingTransparency
  MOLINA_HEALTHCARE_SCRAPER
}

model InsuranceScanSource {
  id                 String                  @id @db.VarChar(50)
  name               String                  @db.VarChar(200)
  notes              String?                 @db.VarChar(5000)
  sourceType         InsuranceScanSourceType
  InsuranceCompany   InsuranceCompany?       @relation(fields: [insuranceCompanyId], references: [id])
  insuranceCompanyId String?                 @db.VarChar(50)
  options            Json?
  createdAt          DateTime                @default(now())
  createdBy          String                  @db.VarChar(50)
  updatedAt          DateTime                @updatedAt
  updatedBy          String                  @db.VarChar(50)
  archivedBy         String?                 @db.VarChar(50)
  archivedAt         DateTime?
  InsuranceScanJob   InsuranceScanJob[]
}

enum InsuranceScanJobStatus {
  PENDING
  DOWNLOADING
  PARSING
  COMPLETED
  DECOMPRESSING
  FAILED
}

model InsuranceScanJob {
  id                             String                          @id @db.VarChar(50)
  insuranceScanSource            InsuranceScanSource?            @relation(fields: [insuranceScanSourceId], references: [id])
  insuranceScanSourceId          String?                         @db.VarChar(50)
  status                         InsuranceScanJobStatus          @default(PENDING)
  statusTime                     DateTime                        @default(now())
  payload                        Json?
  inNetworkObjectsParsed         BigInt?                         @default(0)
  allowedAmountObjectsParsed     BigInt?                         @default(0)
  inNetworkRatesSaved            BigInt?                         @default(0)
  allowedAmountRatesSaved        BigInt?                         @default(0)
  inNetworkRatesWithErrors       BigInt?                         @default(0)
  allowedAmountRatesWithErrors   BigInt?                         @default(0)
  providersParsed                BigInt?                         @default(0)
  plansParsed                    BigInt?                         @default(0)
  providersSaved                 BigInt?                         @default(0)
  plansSaved                     BigInt?                         @default(0)
  fileUrl                        String?                         @db.VarChar(2000)
  insurancePlanIds               String[]
  fileExtension                  FileExtension?
  fileType                       FileType?
  fileSize                       BigInt?
  startedAt                      DateTime?
  completedAt                    DateTime?
  createdAt                      DateTime                        @default(now())
  createdBy                      String                          @db.VarChar(50)
  updatedAt                      DateTime                        @updatedAt
  updatedBy                      String                          @db.VarChar(50)
  parentJobId                    String?                         @db.VarChar(50)
  InsuranceScanSteps             InsuranceScanSteps[]
  insuranceScanDecompressedFiles InsuranceScanDecompressedFile[]
}

model InsuranceScanDecompressedFile {
  id                 String           @id @db.VarChar(50)
  insuranceScanJob   InsuranceScanJob @relation(fields: [insuranceScanJobId], references: [id])
  insuranceScanJobId String           @db.VarChar(50)
  fileName           String           @db.VarChar(500)
  fileType           FileType
  fileExtension      FileExtension
  fileSize           BigInt
  fileHash           String           @db.VarChar(64)
  createdAt          DateTime         @default(now())
}

enum FileType {
  ALLOWED_AMOUNT
  IN_NETWORK
  TABLE_OF_CONTENTS
  UNKNOWN
}

enum FileExtension {
  ZIP
  JSON
  GZ
  UNKNOWN
}

enum InsuranceScanStepType {
  DOWNLOAD
  DECOMPRESS
  PARSE
  POST_PROCESS
  ANALYTICS
}

enum InsuranceScanStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model InsuranceScanSteps {
  id                 String                 @id @db.VarChar(50)
  type               InsuranceScanStepType
  name               String                 @db.VarChar(100)
  description        String?                @db.VarChar(500)
  status             InsuranceScanJobStatus @default(PENDING)
  statusTime         DateTime               @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  sequenceOrder      Int
  InsuranceScanJob   InsuranceScanJob       @relation(fields: [insuranceScanJobId], references: [id])
  insuranceScanJobId String
  createdAt          DateTime               @default(now())
}

enum InsurancePlanIdType {
  EIN
  HIOS
}

enum InsurancePlanMarketType {
  INDIVIDUAL
  GROUP
}

model InsurancePlan {
  id                 String                  @id @db.VarChar(50)
  planName           String                  @db.VarChar(500)
  planIdType         InsurancePlanIdType
  planId             String                  @db.VarChar(100)
  planSponsorName    String?                 @db.VarChar(500)
  planMarketType     InsurancePlanMarketType
  planFirstSeen      DateTime
  planLastSeen       DateTime
  planActive         Boolean                 @default(true)
  insuranceCompany   InsuranceCompany?       @relation(fields: [insuranceCompanyId], references: [id])
  insuranceCompanyId String?                 @db.VarChar(50)
  insurancePlanHash  String?                 @unique @db.VarChar(64)
  parentPlanIds      String[]
  createdAt          DateTime                @default(now())
  createdBy          String                  @db.VarChar(50)
  updatedAt          DateTime                @updatedAt
  updatedBy          String                  @db.VarChar(50)
  archivedBy         String?                 @db.VarChar(50)
  archivedAt         DateTime?

  @@index([planIdType, planId], name: "idx_planIdType_planId")
}

model procedure_code_type {
  id             String           @id @db.VarChar(20)
  type           String           @db.VarChar(100)
  description    String           @db.VarChar(1000)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  procedureCodes procedure_code[]
}

model procedure_code {
  id          Int                 @id @default(autoincrement())
  code        String              @db.VarChar(20)
  CodeType    procedure_code_type @relation(fields: [typeId], references: [id])
  typeId      String              @db.VarChar(20)
  description String              @db.VarChar(1000)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([code, typeId], name: "uq_code_typeId")
}

model provider_group {
  id                     String                    @id @db.VarChar(50)
  groupName              String                    @db.VarChar(200)
  insuranceCarrierId     String                    @db.VarChar(50)
  tinValue               String                    @db.VarChar(20)
  tinType                String                    @db.VarChar(10)
  createdAt              DateTime                  @default(now())
  createdBy              String                    @db.VarChar(50)
  updatedAt              DateTime                  @updatedAt
  updatedBy              String                    @db.VarChar(50)
  archivedBy             String?                   @db.VarChar(50)
  archivedAt             DateTime?
  providerGroupProviders provider_group_provider[]

  @@unique([tinValue, insuranceCarrierId], name: "uq_tin_carrier")
}

model provider_group_provider {
  id              String         @id @db.VarChar(50)
  providerGroup   provider_group @relation(fields: [providerGroupId], references: [id])
  providerGroupId String         @db.VarChar(50)
  provider        provider       @relation(fields: [providerId], references: [id])
  providerId      String         @db.VarChar(50)
  firstSeen       DateTime       @default(now())
  lastSeen        DateTime       @default(now())
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@index([providerId], name: "idx_pgp_providerId")
  @@index([providerGroupId], name: "idx_pgp_providerGroupId")
}

model provider {
  id                               String                            @id @db.VarChar(50)
  providerNPI                      String                            @unique @db.VarChar(20)
  entityTypeCode                   EntityTypeCode
  replacementNPI                   String?                           @db.VarChar(20)
  ein                              String?                           @db.VarChar(20)
  businessName                     String?                           @db.VarChar(250)
  firstName                        String?                           @db.VarChar(250)
  lastName                         String?                           @db.VarChar(250)
  middleName                       String?                           @db.VarChar(100)
  namePrefix                       String?                           @db.VarChar(10)
  nameSuffix                       String?                           @db.VarChar(10)
  credential                       String?                           @db.VarChar(50)
  otherOrganizationName            String?                           @db.VarChar(250)
  otherOrganizationNameTypeCode    OtherProviderNameTypeCode?
  otherLastName                    String?                           @db.VarChar(250)
  otherFirstName                   String?                           @db.VarChar(250)
  otherMiddleName                  String?                           @db.VarChar(100)
  otherNamePrefix                  String?                           @db.VarChar(10)
  otherNameSuffix                  String?                           @db.VarChar(10)
  otherCredential                  String?                           @db.VarChar(50)
  otherLastNameTypeCode            OtherProviderNameTypeCode?
  enumerationDate                  DateTime?
  lastUpdateDate                   DateTime?
  deactivationReasonCode           DeactivationReasonCode?
  deactivationDate                 DateTime?
  reactivationDate                 DateTime?
  genderCode                       GenderCode?
  isSoleProprietor                 SoleProprietorCode?
  isOrganizationSubpart            SubpartCode?
  parentOrganizationName           String?                           @db.VarChar(250)
  parentOrganizationTIN            String?                           @db.VarChar(20)
  certificationDate                DateTime?
  authorizedOfficialLastName       String?                           @db.VarChar(250)
  authorizedOfficialFirstName      String?                           @db.VarChar(250)
  authorizedOfficialMiddleName     String?                           @db.VarChar(100)
  authorizedOfficialTitle          String?                           @db.VarChar(100)
  authorizedOfficialPhone          String?                           @db.VarChar(20)
  authorizedOfficialNamePrefix     String?                           @db.VarChar(10)
  authorizedOfficialNameSuffix     String?                           @db.VarChar(10)
  authorizedOfficialCredential     String?                           @db.VarChar(50)
  createdAt                        DateTime                          @default(now())
  createdBy                        String                            @db.VarChar(50)
  updatedAt                        DateTime                          @updatedAt
  updatedBy                        String                            @db.VarChar(50)
  deactivatedAt                    DateTime?
  deactivatedBy                    String                            @db.VarChar(50)
  archivedAt                       DateTime?
  archivedBy                       String                            @db.VarChar(50)
  providerGroupProviders           provider_group_provider[]
  providerAddresses                providerAddress[]
  providerLicenses                 providerLicense[]
  providerTaxonomies               providerTaxonomy[]
  providerOtherProviderIdentifiers providerOtherProviderIdentifier[]

  @@index([entityTypeCode, lastName], name: "idx_provider_type_lastName")
  @@index([entityTypeCode, businessName], name: "idx_provider_type_businessName")
  @@index([entityTypeCode, updatedAt(sort: Desc)], name: "idx_provider_type_updated")
  @@index([lastName], name: "idx_provider_lastName")
  @@index([firstName], name: "idx_provider_firstName")
  @@index([businessName], name: "idx_provider_businessName")
  @@index([credential], name: "idx_provider_credential")
  @@index([ein], name: "idx_provider_ein")
  @@index([deactivationDate], name: "idx_provider_deactivationDate")
}

model providerAddress {
  id          String              @id @db.VarChar(50)
  provider    provider            @relation(fields: [providerId], references: [id])
  providerId  String              @db.VarChar(50)
  addressType ProviderAddressType
  address1    String              @db.VarChar(250)
  address2    String?             @db.VarChar(250)
  city        String              @db.VarChar(100)
  state       String              @db.VarChar(50)
  zipCode     String              @db.VarChar(20)
  country     String?             @db.VarChar(5)
  phone       String?             @db.VarChar(20)
  fax         String?             @db.VarChar(20)
  createdAt   DateTime            @default(now())
  createdBy   String              @db.VarChar(50)
  updatedAt   DateTime            @updatedAt
  updatedBy   String              @db.VarChar(50)
  archivedAt  DateTime?
  archivedBy  String              @db.VarChar(50)

  @@index([providerId], name: "idx_providerAddress_providerId")
  @@index([state], name: "idx_providerAddress_state")
  @@index([zipCode], name: "idx_providerAddress_zipCode")
  @@index([city, state], name: "idx_providerAddress_city_state")
}

model providerLicense {
  id            String    @id @db.VarChar(50)
  provider      provider  @relation(fields: [providerId], references: [id])
  providerId    String    @db.VarChar(50)
  licenseNumber String    @db.VarChar(100)
  state         String    @db.VarChar(50)
  createdAt     DateTime  @default(now())
  createdBy     String    @db.VarChar(50)
  updatedAt     DateTime  @updatedAt
  updatedBy     String    @db.VarChar(50)
  archivedAt    DateTime?
  archivedBy    String    @db.VarChar(50)

  @@index([providerId], name: "idx_providerLicense_providerId")
  @@index([state], name: "idx_providerLicense_state")
}

model providerTaxonomy {
  id            String              @id @db.VarChar(50)
  provider      provider            @relation(fields: [providerId], references: [id])
  providerId    String              @db.VarChar(50)
  taxonomyCode  String              @db.VarChar(20)
  licenseNumber String?             @db.VarChar(100)
  licenseState  String?             @db.VarChar(5)
  isPrimary     PrimaryTaxonomyCode @default(X)
  groupCode     String?             @db.VarChar(250)
  createdAt     DateTime            @default(now())
  createdBy     String              @db.VarChar(50)
  updatedAt     DateTime            @updatedAt
  updatedBy     String              @db.VarChar(50)
  archivedAt    DateTime?
  archivedBy    String              @db.VarChar(50)

  @@index([providerId], name: "idx_providerTaxonomy_providerId")
  @@index([taxonomyCode], name: "idx_providerTaxonomy_taxonomyCode")
}

model providerOtherProviderIdentifier {
  id         String                          @id @db.VarChar(50)
  provider   provider                        @relation(fields: [providerId], references: [id])
  providerId String                          @db.VarChar(50)
  name       String                          @db.VarChar(250)
  typeCode   OtherProviderIdentifierTypeCode
  state      String                          @db.VarChar(2)
  issure     String                          @db.VarChar(250)
  createdAt  DateTime                        @default(now())
  createdBy  String                          @db.VarChar(50)
  updatedAt  DateTime                        @updatedAt
  updatedBy  String                          @db.VarChar(50)
  archivedAt DateTime?
  archivedBy String                          @db.VarChar(50)

  @@index([providerId], name: "idx_providerOtherId_providerId")
}

enum ProviderAddressType {
  MAILING
  PRACTICE
}

enum EntityTypeCode {
  INDIVIDUAL // 1
  ORGANIZATION // 2
}

enum SoleProprietorCode {
  X // Not Answered
  Y // Yes
  N // No
}

enum SubpartCode {
  X // Not Answered
  Y // Yes
  N // No
}

enum GenderCode {
  M // Male
  F // Female
}

enum DeactivationReasonCode {
  DT // Death
  DB // Disbandment
  FR // Fraud
  OT // Other
}

enum OtherProviderNameTypeCode {
  FORMER_NAME // 1 - Individual
  PROFESSIONAL_NAME // 2 - Individual
  DOING_BUSINESS_AS // 3 - Organization
  FORMER_LEGAL_BUSINESS // 4 - Organization
  OTHER_NAME // 5 - Both
}

enum PrimaryTaxonomyCode {
  X // Not Answered
  Y // Yes
  N // No
}

enum OtherProviderIdentifierTypeCode {
  OTHER
  MEDICARE_UPIN
  MEDICAR_ID_TYPE_UNSPECIFIED
  MEDICAID
  MEDICARE_OSCAR_CERTIFICATION
  MEDICARE_NSC
  MEDICARE_PIN
}
