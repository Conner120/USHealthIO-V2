# ---- Output sink ------------------------------------------------------------
# clickhouse (default) | rabbitmq | none
SINK=clickhouse
# Alias: setting this to false forces SINK=rabbitmq back to clickhouse.
# PUBSUB_ENABLED=false

# Zombie-rate filter (structural plausibility of class/code/type/modifier, see src/allowlist.rs).
# Every row is tagged with zombie_verdict/zombie_rule in ClickHouse regardless; this decides what is dropped.
# off (default: tag only) | deny (skip DENY rows) | review (skip DENY and REVIEW rows)
ZOMBIE_FILTER=off

# ---- ClickHouse -------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123          # https://<host>:8443 for ClickHouse Cloud
CLICKHOUSE_DATABASE=health
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# v2 content-addressed tables (clickhouse-schema/schema.sql)
CLICKHOUSE_TABLE_RATES=rates
CLICKHOUSE_TABLE_RATE_SEEN=rate_seen
CLICKHOUSE_TABLE_PROVIDER_GROUPS=provider_groups
CLICKHOUSE_TABLE_PROVIDER_GROUP_SEEN=provider_group_seen
CLICKHOUSE_TABLE_FILES=mrf_files
# Canonical URL of the file being parsed; recorded on mrf_files.file_url (set by the job runner)
FILE_URL=
# Batch sizing: one INSERT statement (= one MergeTree part) per threshold crossed.
# Rows are buffered in memory until a batch is full, then sent as ONE INSERT (opened, written,
# ended immediately — no statement is ever held open waiting for rows). The buffer is what makes a
# failed insert retryable, so it also bounds memory: rows x workers x ~200 B.
CLICKHOUSE_INSERT_MAX_ROWS=100000
CLICKHOUSE_INSERT_MAX_BYTES=268435456           # 256 MiB uncompressed (advisory)

# Retries. Every insert is retried with exponential backoff + jitter; the parser can run for hours,
# so a ClickHouse restart or failover should cost a pause, not the job.
CLICKHOUSE_MAX_RETRIES=0                        # 0 = retry forever; N = abort the job after N retries
CLICKHOUSE_RETRY_ABORT_SECS=0                   # 0 = never; N = abort the job after N seconds on ONE batch
CLICKHOUSE_RETRY_BASE_MS=500                    # first backoff, doubled each attempt
CLICKHOUSE_RETRY_MAX_MS=60000                   # backoff ceiling
CLICKHOUSE_COMPRESSION=lz4                      # lz4 | zstd | zstd:<level> | none  (zstd when the network link is the bottleneck)
CLICKHOUSE_VALIDATE_SCHEMA=false                # keep false: the client cannot validate SimpleAggregateFunction(…, LowCardinality) columns
# Client-side timeouts. Generous on purpose: a busy server merging parts can take minutes to ack a
# large INSERT, and giving up early only makes the batch be re-sent.
CLICKHOUSE_SEND_TIMEOUT_SECS=300
CLICKHOUSE_END_TIMEOUT_SECS=1800
# Server-side socket read timeout for our requests (sent as a query setting). The cluster default
# of 30s is what produced `Code: 209 SOCKET_TIMEOUT`. Anything in CLICKHOUSE_SETTINGS overrides it.
CLICKHOUSE_RECEIVE_TIMEOUT_SECS=600
# Extra server settings applied to every request, comma separated key=value.
# CLICKHOUSE_SETTINGS=max_insert_threads=4,async_insert=0

# ---- RabbitMQ (only when SINK=rabbitmq) -------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5552
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SHARD_ID=0
RABBITMQ_BATCH_PRICES=50000
RABBITMQ_STREAM_MAX_GB=10

# ---- Parser -----------------------------------------------------------------
# PARSER_THREADS=18                             # worker tasks; default = all available cores
PARSER_QUEUE_DEPTH=1024                         # scanner -> worker queue (elements, zero-copy mmap slices)
PARSER_LOCATION_RETRIES=3                       # retries per provider_references[].location fetch
PARSER_MAX_ELEMENT_ERRORS=1000                  # abort job after this many unparseable elements (0 = never)
PARSER_PROGRESS_SECS=5

# ---- Parser memory ----------------------------------------------------------
# The parser mmaps the file, so every page the scanner touches stays resident until the kernel
# reclaims it — left alone, RSS grows to the size of the whole file. These hand scanned pages back
# as the scan moves on, which keeps resident memory flat regardless of file size.
# NOTE: honoured on Linux (where the services run); macOS ignores MADV_DONTNEED for file-backed
# maps, so RSS still tracks the file there.
PARSER_MMAP_RELEASE_MB=64                       # release granularity; 0 disables. Peak RSS ~= 2x(this + lag)
PARSER_MMAP_RELEASE_LAG_MB=16                   # keep this much behind the scanner for in-flight workers

# Distinct rate hashes tracked in memory so each `rates` row is written once per job (~40 B each).
# Past the cap the parser stops deduplicating and lets ClickHouse collapse duplicates on merge
# (`rates` is an AggregatingMergeTree keyed by rate_hash), which bounds this at ~200 MB.
# 0 = never cap (memory then scales with the number of distinct prices in the file).
PARSER_RATE_DEDUP_MAX=5000000
