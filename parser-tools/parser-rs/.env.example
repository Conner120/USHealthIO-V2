# ---- Output sink ------------------------------------------------------------
# clickhouse (default) | rabbitmq | none
SINK=clickhouse
# Alias: setting this to false forces SINK=rabbitmq back to clickhouse.
# PUBSUB_ENABLED=false

# Zombie-rate filter (structural plausibility of class/code/type/modifier, see src/allowlist.rs).
# Every row is tagged with zombie_verdict/zombie_rule in ClickHouse regardless; this decides what is dropped.
# off (default: tag only) | deny (skip DENY rows) | review (skip DENY and REVIEW rows)
ZOMBIE_FILTER=off

# ---- ClickHouse -------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123          # https://<host>:8443 for ClickHouse Cloud
CLICKHOUSE_DATABASE=health
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TABLE_RATES=in_network_rates
CLICKHOUSE_TABLE_PROVIDER_GROUPS=provider_groups
CLICKHOUSE_TABLE_FILES=mrf_files
# Batch sizing: one INSERT statement (= one MergeTree part) per threshold crossed.
CLICKHOUSE_INSERT_MAX_ROWS=500000
CLICKHOUSE_INSERT_MAX_BYTES=268435456           # 256 MiB uncompressed
CLICKHOUSE_INSERT_PERIOD_SECS=0                 # 0 = no time-based flush (size-bounded only)
CLICKHOUSE_COMPRESSION=lz4                      # lz4 | zstd | zstd:<level> | none  (zstd when the network link is the bottleneck)
CLICKHOUSE_VALIDATE_SCHEMA=false                # true = fetch schema + type-check rows (slower; use when changing the schema)
CLICKHOUSE_SEND_TIMEOUT_SECS=60
CLICKHOUSE_END_TIMEOUT_SECS=600
# Extra server settings applied to every request, comma separated key=value.
# CLICKHOUSE_SETTINGS=max_insert_threads=4,async_insert=0

# ---- RabbitMQ (only when SINK=rabbitmq) -------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5552
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SHARD_ID=0
RABBITMQ_BATCH_PRICES=50000
RABBITMQ_STREAM_MAX_GB=10

# ---- Parser -----------------------------------------------------------------
# PARSER_THREADS=18                             # worker tasks; default = all available cores
PARSER_QUEUE_DEPTH=1024                         # scanner -> worker queue (elements, zero-copy mmap slices)
PARSER_LOCATION_RETRIES=3                       # retries per provider_references[].location fetch
PARSER_MAX_ELEMENT_ERRORS=1000                  # abort job after this many unparseable elements (0 = never)
PARSER_PROGRESS_SECS=5
